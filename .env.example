# Discord Developer Portal -> your app -> General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Discord Developer Portal -> your app -> Bot -> Reset Token
# Only used locally by `npm run register`. Do NOT add it to Vercel.
DISCORD_BOT_TOKEN=

# Optional: register commands to one guild only (instant updates while testing).
# Leave empty to register globally.
DISCORD_GUILD_ID=

# MongoDB Atlas -> Connect -> Drivers
MONGODB_URI=
# Optional, defaults to "mcstatus"
MONGODB_DB=mcstatus
